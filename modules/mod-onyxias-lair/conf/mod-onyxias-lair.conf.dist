###################################################################################################
# mod-onyxias-lair module configuration
###################################################################################################

[ModuleConf]

# mod-onyxias-lair.Enable
#     Register Onyxias Lair's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-onyxias-lair.Enable = 1
