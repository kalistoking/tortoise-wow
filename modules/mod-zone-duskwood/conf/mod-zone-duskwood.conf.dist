###################################################################################################
# mod-zone-duskwood module configuration
###################################################################################################

[ModuleConf]

# mod-zone-duskwood.Enable
#     Register Duskwood's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-zone-duskwood.Enable = 1
