###################################################################################################
# mod-event-bloody-coins module configuration
###################################################################################################

[ModuleConf]

# mod-event-bloody-coins.Enable
#     Register Bloody Coins's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-event-bloody-coins.Enable = 1
