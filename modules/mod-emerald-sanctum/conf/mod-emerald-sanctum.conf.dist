###################################################################################################
# mod-emerald-sanctum module configuration
###################################################################################################

[ModuleConf]

# mod-emerald-sanctum.Enable
#     Register Emerald Sanctum's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-emerald-sanctum.Enable = 1
