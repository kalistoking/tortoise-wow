###################################################################################################
# mod-ruins-of-ahnqiraj module configuration
###################################################################################################

[ModuleConf]

# mod-ruins-of-ahnqiraj.Enable
#     Register Ruins Of Ahnqiraj's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-ruins-of-ahnqiraj.Enable = 1
