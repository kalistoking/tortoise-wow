###################################################################################################
# mod-event-mirage-raceway module configuration
###################################################################################################

[ModuleConf]

# mod-event-mirage-raceway.Enable
#     Register Mirage Raceway's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-event-mirage-raceway.Enable = 1
