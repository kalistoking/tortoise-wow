###################################################################################################
# mod-scarlet-monastery module configuration
###################################################################################################

[ModuleConf]

# mod-scarlet-monastery.Enable
#     Register Scarlet Monastery's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-scarlet-monastery.Enable = 1
