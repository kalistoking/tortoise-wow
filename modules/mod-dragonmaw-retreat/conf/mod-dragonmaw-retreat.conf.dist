###################################################################################################
# mod-dragonmaw-retreat module configuration
###################################################################################################

[ModuleConf]

# mod-dragonmaw-retreat.Enable
#     Register Dragonmaw Retreat's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-dragonmaw-retreat.Enable = 1
