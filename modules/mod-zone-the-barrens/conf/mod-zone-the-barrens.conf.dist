###################################################################################################
# mod-zone-the-barrens module configuration
###################################################################################################

[ModuleConf]

# mod-zone-the-barrens.Enable
#     Register The Barrens's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-zone-the-barrens.Enable = 1
