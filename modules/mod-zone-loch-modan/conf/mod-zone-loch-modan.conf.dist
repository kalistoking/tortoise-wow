###################################################################################################
# mod-zone-loch-modan module configuration
###################################################################################################

[ModuleConf]

# mod-zone-loch-modan.Enable
#     Register Loch Modan's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-zone-loch-modan.Enable = 1
