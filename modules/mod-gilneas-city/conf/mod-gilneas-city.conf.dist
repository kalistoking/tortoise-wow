###################################################################################################
# mod-gilneas-city module configuration
###################################################################################################

[ModuleConf]

# mod-gilneas-city.Enable
#     Register Gilneas City's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-gilneas-city.Enable = 1
