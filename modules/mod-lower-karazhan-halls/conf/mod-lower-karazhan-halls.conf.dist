###################################################################################################
# mod-lower-karazhan-halls module configuration
###################################################################################################

[ModuleConf]

# mod-lower-karazhan-halls.Enable
#     Register Lower Karazhan Halls's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-lower-karazhan-halls.Enable = 1
