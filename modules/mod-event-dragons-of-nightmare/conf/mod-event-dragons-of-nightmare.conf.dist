###################################################################################################
# mod-event-dragons-of-nightmare module configuration
###################################################################################################

[ModuleConf]

# mod-event-dragons-of-nightmare.Enable
#     Register the Dragons of Nightmare's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-event-dragons-of-nightmare.Enable = 1
