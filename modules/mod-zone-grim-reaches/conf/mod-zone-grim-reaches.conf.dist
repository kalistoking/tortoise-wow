###################################################################################################
# mod-zone-grim-reaches module configuration
###################################################################################################

[ModuleConf]

# mod-zone-grim-reaches.Enable
#     Register Grim Reaches's scripts. When 0 the module registers nothing: the world database
#     still names the scripts, and their creatures and objects run on what the core gives them
#     without one -- their ai_name, their rows.
#     Default: 1
mod-zone-grim-reaches.Enable = 1
